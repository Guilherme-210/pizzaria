{
  "name": "pizzaria",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "author": "Guilherme Luiz Reis do Nascimento",
  "description": "Full-stack application for Pizzaria project",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:frontend": "yarn workspace frontend build",
    "dev:frontend": "yarn workspace frontend dev",
    "add:frontend": "yarn workspace frontend add",
    "install:frontend": "yarn workspace frontend install",
    "build:backend": "yarn workspace backend build",
    "dev:backend": "yarn workspace backend dev",
    "add:backend": "yarn workspace backend add",
    "install:backend": "yarn workspace backend install",
    "dev:all": "yarn dev:backend && yarn dev:frontend",
    "build:all": "yarn build:backend && yarn build:frontend",
    "install:all": "yarn install:frontend && yarn install:backend",
    "db:init": "yarn workspace backend prisma init",
    "db:generate": "yarn workspace backend db:generate",
    "db:push": "yarn workspace backend db:push",
    "db:migrate": "yarn workspace backend db:migrate",
    "db:deploy": "yarn workspace backend db:deploy",
    "db:studio": "yarn workspace backend db:studio"
  }
}
